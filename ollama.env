# Ollama Model Settings (optimal for 16 GB VRAM with 100% offload)
OLLAMA_MODEL=hf.co/nohurry/gemma-4-26B-A4B-it-heretic-GUFF:IQ4_XS
OLLAMA_KV_CACHE_TYPE=q4_0

# Ollama API Settings (sane defaults)
OLLAMA_HOST=0.0.0.0
OLLAMA_KEEP_ALIVE=-1

# Bots Settings (set to you PC's static IP set via router DHCP)
# Note: Wrong IP would mean Pi not reaching out
OLLAMA_API_URL=http://192.168.1.101:11434/api/generate
