[Unit]
Description="Telellama Bot Handler Service"
After=ollama.service

[Container]
ContainerName=bots
Image=docker.io/veotri/telellama-bots

# --- Environment ---
# Load dynamic variables (OLLAMA_API_URL, OLLAMA_MODEL)
EnvironmentFile=/etc/telellama/ollama.env
# Set static variable to find secret
Environment=API_KEYS_FILE=/run/secrets/api_keys

# --- Secret ---
Secret=api_keys,type=mount,source=/etc/telellama/api_keys.txt
Volume=/etc/telellama/ollama-entrypoint.sh:/usr/local/bin/entrypoint.sh:ro,Z

# --- Volumes ---
Volume=/etc/telellama/confs:/app/confs:ro:Z
Volume=%h/.local/share/bots-data/history:/app/history:Z

[Service]
Restart=always
TimeoutStartSec=0

[Install]
WantedBy=default.target
